# AquaGuard .gitignore

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/
go.sum

# Rust
/security/target/
debug/
*.pdb
Cargo.lock

# Node.js / Next.js
node_modules/
.next/
out/
.vercel
*.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment
.env
.env.local
.env*.local

# OS
.DS_Store
Thumbs.db

# Data files
*.log
data/*.json
!data/.gitkeep

# Docker
.docker/
